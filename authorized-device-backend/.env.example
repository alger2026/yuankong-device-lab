# Required only when a new database is initialized.
ADB_ADMIN_USERNAME=admin
ADB_ADMIN_PASSWORD=replace-with-at-least-12-characters

ADB_DB_PATH=./data/backend.sqlite3
ADB_SESSION_TTL_SECONDS=28800
ADB_REAUTH_TTL_SECONDS=300
ADB_WS_TICKET_TTL_SECONDS=45
ADB_DEVICE_OFFLINE_SECONDS=90

# Disabled by default. Only appropriate for documented Android Enterprise
# device-owner deployments. It must not be used to lock personal devices.
ADB_ENABLE_DEVICE_LOCK=false

